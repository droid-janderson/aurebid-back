generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUCTIONEER
  BIDDER
}

enum LotStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  SETTLED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum WalletTransactionType {
  DEPOSIT
  BUYER_SETTLEMENT_DEBIT
  SELLER_SETTLEMENT_CREDIT
  REFUND
  ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lots              Lot[]       @relation("LotSeller")
  bids              Bid[]       @relation("Bidder")
  wallet            Wallet?
  purchases         Settlement[] @relation("SettlementBuyer")
  sales             Settlement[] @relation("SettlementSeller")
}

model Lot {
  id                String    @id @default(cuid())
  sellerId          String
  productSource     String
  externalProductId String
  title             String
  description       String?
  imageUrl          String?
  productData       Json?
  startingPrice     Decimal   @db.Decimal(14, 2)
  minimumIncrement  Decimal   @db.Decimal(14, 2)
  startsAt          DateTime
  endsAt            DateTime
  status            LotStatus @default(DRAFT)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  seller       User                 @relation("LotSeller", fields: [sellerId], references: [id])
  bids         Bid[]
  auditEntries BidAudit[]
  reservations WalletReservation[]
  settlement   Settlement?

  @@index([status, startsAt, endsAt])
  @@index([sellerId, createdAt])
  @@index([productSource, externalProductId])
}

model Bid {
  id        String   @id @default(cuid())
  lotId     String
  bidderId  String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  lot         Lot                @relation(fields: [lotId], references: [id])
  bidder      User               @relation("Bidder", fields: [bidderId], references: [id])
  audit       BidAudit?
  reservation WalletReservation?
  settlement  Settlement?

  @@index([lotId, createdAt])
  @@index([bidderId, createdAt])
}

model BidAudit {
  id          String   @id @default(cuid())
  bidId       String   @unique
  lotId       String
  sequence    Int
  previousHash String?
  currentHash  String
  createdAt   DateTime @default(now())

  bid Bid @relation(fields: [bidId], references: [id])
  lot Lot @relation(fields: [lotId], references: [id])

  @@unique([lotId, sequence])
  @@index([lotId, currentHash])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  reservations WalletReservation[]
  transactions WalletTransaction[]
}

model WalletReservation {
  id        String            @id @default(cuid())
  walletId  String
  lotId     String
  bidId     String?           @unique
  amount    Decimal           @db.Decimal(14, 2)
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  lot    Lot    @relation(fields: [lotId], references: [id])
  bid    Bid?   @relation(fields: [bidId], references: [id])

  @@unique([walletId, lotId])
  @@index([walletId, status])
  @@index([lotId, status])
}

model WalletTransaction {
  id           String               @id @default(cuid())
  walletId     String
  settlementId String?
  type         WalletTransactionType
  amount       Decimal              @db.Decimal(14, 2)
  description  String?
  createdAt    DateTime             @default(now())

  wallet     Wallet      @relation(fields: [walletId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@unique([settlementId, type])
  @@index([walletId, createdAt])
}

model Settlement {
  id            String           @id @default(cuid())
  lotId         String           @unique
  winningBidId  String           @unique
  buyerId       String
  sellerId      String
  amount        Decimal          @db.Decimal(14, 2)
  receiptNumber String           @unique
  publicToken   String           @unique @default(cuid())
  status        SettlementStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lot           Lot                 @relation(fields: [lotId], references: [id])
  winningBid    Bid                 @relation(fields: [winningBidId], references: [id])
  buyer         User                @relation("SettlementBuyer", fields: [buyerId], references: [id])
  seller        User                @relation("SettlementSeller", fields: [sellerId], references: [id])
  transactions  WalletTransaction[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}