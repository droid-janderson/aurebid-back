generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  batchs       Batch[]      @relation("BatchSeller")
  bids         Bid[]        @relation("Bidder")
  purchases    Settlement[] @relation("SettlementBuyer")
  sales        Settlement[] @relation("SettlementSeller")
  wallet       Wallet?
}

model Batch {
  id                String              @id @default(cuid())
  sellerId          String
  productSource     String
  externalProductId String
  title             String
  description       String?
  imageUrl          String?
  productData       Json?
  startingPrice     Decimal             @db.Decimal(14, 2)
  minimumIncrement  Decimal             @db.Decimal(14, 2)
  startsAt          DateTime
  endsAt            DateTime
  status            BatchStatus         @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  seller            User                @relation("BatchSeller", fields: [sellerId], references: [id])
  bids              Bid[]
  auditEntries      BidAudit[]
  settlement        Settlement?
  reservations      WalletReservation[]

  @@index([status, startsAt, endsAt])
  @@index([sellerId, createdAt])
  @@index([productSource, externalProductId])
}

model Bid {
  id          String             @id @default(cuid())
  batchId     String
  bidderId    String
  amount      Decimal            @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())
  batch       Batch              @relation(fields: [batchId], references: [id])
  bidder      User               @relation("Bidder", fields: [bidderId], references: [id])
  audit       BidAudit?
  settlement  Settlement?
  reservation WalletReservation?

  @@index([batchId, createdAt])
  @@index([bidderId, createdAt])
}

model BidAudit {
  id           String   @id @default(cuid())
  bidId        String   @unique
  batchId      String
  sequence     Int
  previousHash String?
  currentHash  String
  createdAt    DateTime @default(now())
  batch        Batch    @relation(fields: [batchId], references: [id])
  bid          Bid      @relation(fields: [bidId], references: [id])

  @@unique([batchId, sequence])
  @@index([batchId, currentHash])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(0) @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  reservations WalletReservation[]
  transactions WalletTransaction[]
}

model WalletReservation {
  id        String            @id @default(cuid())
  walletId  String
  batchId   String
  bidId     String?           @unique
  amount    Decimal           @db.Decimal(14, 2)
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  batch     Batch             @relation(fields: [batchId], references: [id])
  bid       Bid?              @relation(fields: [bidId], references: [id])
  wallet    Wallet            @relation(fields: [walletId], references: [id])

  @@unique([walletId, batchId])
  @@index([walletId, status])
  @@index([batchId, status])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  settlementId String?
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 2)
  description  String?
  createdAt    DateTime              @default(now())
  settlement   Settlement?           @relation(fields: [settlementId], references: [id])
  wallet       Wallet                @relation(fields: [walletId], references: [id])

  @@unique([settlementId, type])
  @@index([walletId, createdAt])
}

model Settlement {
  id            String              @id @default(cuid())
  batchId       String              @unique
  winningBidId  String              @unique
  buyerId       String
  sellerId      String
  amount        Decimal             @db.Decimal(14, 2)
  receiptNumber String              @unique
  publicToken   String              @unique @default(cuid())
  status        SettlementStatus    @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  batch         Batch               @relation(fields: [batchId], references: [id])
  buyer         User                @relation("SettlementBuyer", fields: [buyerId], references: [id])
  seller        User                @relation("SettlementSeller", fields: [sellerId], references: [id])
  winningBid    Bid                 @relation(fields: [winningBidId], references: [id])
  transactions  WalletTransaction[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}

enum UserRole {
  ADMIN
  AUCTIONEER
  BIDDER
}

enum BatchStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  SETTLED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum WalletTransactionType {
  DEPOSIT
  BUYER_SETTLEMENT_DEBIT
  SELLER_SETTLEMENT_CREDIT
  REFUND
  ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
