# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurebid?schema=public"
POSTGRES_USER=name_user
POSTGRES_PASSWORD=pass_user
POSTGRES_DB=name_db

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Socket.io
SOCKET_IO_CORS_ORIGIN=http://localhost:3001

# Public labels (HMAC key). Falls back to JWT_SECRET when omitted.
PSEUDONYM_SECRET=

# Auction lifecycle
AUCTION_SWEEP_INTERVAL_MS=30000
SETTLEMENT_MAX_ATTEMPTS=5